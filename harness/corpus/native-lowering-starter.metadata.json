{
  "name": "native-lowering-starter",
  "purpose": "Focused Prometheus-backed differential corpus for the native SQL lowering roadmap through Phase 6 range functions and subqueries.",
  "sourcePlan": ".pi/native-sql-lowering-plan/01-context-and-guardrails.md",
  "baselineDoc": ".pi/native-sql-lowering-plan/phase-0-baseline.md",
  "notes": [
    "This is intentionally narrower than harness/corpus/queries.json.",
    "It is meant for frequent execution while native lowering analysis/types/selector lowering are in flight.",
    "Rate-family and counter-family rows use structural comparison explicitly to avoid treating current extrapolation or edge-inclusion differences as phase blockers while planner/native-lowering coverage is being expanded.",
    "Range-query rows were extended in Phase 6 to cover both direct-selector and subquery-backed native range lowering."
  ],
  "buckets": [
    {
      "name": "selectors",
      "targetPhases": ["phase-1-analysis-scaffolding", "phase-3-selector-lowering"],
      "queryNames": [
        "native_lowering_selector_instant",
        "native_lowering_selector_matcher_instant",
        "native_lowering_selector_offset_instant",
        "native_lowering_selector_range"
      ]
    },
    {
      "name": "aggregations",
      "targetPhases": ["phase-1-analysis-scaffolding", "phase-2-native-subtree-and-renderer", "phase-4-sql-optimizer-passes"],
      "queryNames": [
        "native_lowering_sum_by_job_instant",
        "native_lowering_sum_by_job_range",
        "native_lowering_sum_by_job_scaled_instant",
        "native_lowering_avg_by_job_negated_range"
      ]
    },
    {
      "name": "joins",
      "targetPhases": ["phase-5-join-and-vector-matching-lowering"],
      "queryNames": [
        "native_lowering_vector_vector_instant",
        "native_lowering_vector_match_group_left_instant"
      ]
    },
    {
      "name": "range-functions",
      "targetPhases": ["phase-6-range-functions-and-subqueries"],
      "queryNames": [
        "native_lowering_sum_over_time_selector_range",
        "native_lowering_count_over_time_selector_range",
        "native_lowering_last_over_time_subquery_range",
        "native_lowering_sum_over_time_subquery_range"
      ]
    },
    {
      "name": "counters",
      "targetPhases": ["phase-6-range-functions-and-subqueries"],
      "queryNames": [
        "native_lowering_rate_selector_instant",
        "native_lowering_sum_rate_by_job_instant",
        "native_lowering_increase_selector_instant",
        "native_lowering_rate_selector_range",
        "native_lowering_increase_selector_range",
        "native_lowering_rate_subquery_range"
      ],
      "compareMode": "structural"
    },
    {
      "name": "subqueries",
      "targetPhases": ["phase-1-analysis-scaffolding", "phase-6-range-functions-and-subqueries"],
      "queryNames": [
        "native_lowering_subquery_matrix_root_selector_instant",
        "native_lowering_subquery_local_child_instant"
      ]
    }
  ]
}
