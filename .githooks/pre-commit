#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "Checking staged diff for whitespace errors..."
git diff --cached --check

changed_files=$(git diff --cached --name-only)
if [ -z "$changed_files" ]; then
  exit 0
fi

if printf '%s\n' "$changed_files" | grep -Eq '(^|/)(go\.mod|go\.sum)$|\.go$|^Makefile$|^\.githooks/|^\.golangci\.ya?ml$|^\.github/workflows/'; then
  echo "Running fast pre-commit checks..."
  make pre-commit
else
  echo "No Go or tooling changes staged; skipping Go pre-commit checks."
fi
