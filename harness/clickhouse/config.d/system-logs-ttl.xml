<clickhouse>
  <!-- Cap retention on ClickHouse's system log tables so they don't grow
       unbounded in the persisted data volume, while keeping a one-hour window
       to investigate a recent compliance run. TTL is on event_time (not
       event_date) for hour-resolution; this triggers row-level TTL inside
       parts during merges rather than whole-partition drops, which is more
       merge work but the only way to get sub-day retention.

       Note: TTL config only applies at table-creation time. If the volume
       already contains these tables, run `ALTER TABLE system.<name> MODIFY TTL
       event_time + INTERVAL 1 HOUR` once to retrofit, or drop the volume to
       let them be recreated with the new TTL. -->
  <text_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </text_log>
  <query_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </query_log>
  <query_thread_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </query_thread_log>
  <query_views_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </query_views_log>
  <part_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </part_log>
  <metric_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </metric_log>
  <query_metric_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </query_metric_log>
  <asynchronous_metric_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </asynchronous_metric_log>
  <trace_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </trace_log>
  <asynchronous_insert_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </asynchronous_insert_log>
  <processors_profile_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </processors_profile_log>
  <error_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </error_log>
  <background_schedule_pool_log>
    <ttl>event_time + INTERVAL 1 HOUR</ttl>
  </background_schedule_pool_log>
</clickhouse>
